# Пример конфигурации проекта picurl
# Скопируйте этот файл в .env и отредактируйте под ваше окружение
#
# Выбор провайдера ИИ:
# 1. Antigravity (Google Gemini) — значение по умолчанию
# 2. Claude — через Claude Agent SDK поверх локального Claude Code CLI
#    (как в соседнем проекте workflow-ai), с двумя способами аутентификации
#
# Детальные инструкции: https://github.com/stefan200707/picurl/blob/main/ENABLE_ANTIGRAVITY.md

# ============================================================================
# 1. ЗАЩИТА СЛУЖЕБНЫХ ЭНДПОИНТОВ
# ============================================================================
# Токен для защиты POST /internal/refresh-dicts (обновление справочников)
# Установите на произвольное стойкое значение (или оставьте пустым, тогда эндпоинт отключен)
INTERNAL_REFRESH_TOKEN=your_super_secret_token_here

# ============================================================================
# 2. НАСТРОЙКА ИИ-ОБОГАЩЕНИЯ (AI Enrichment)
# ============================================================================

# Включение/отключение ИИ-слоя
# true  = ИИ-обогащение включено (используется для сложных контекстных запросов)
# false = Только детерминированный парсинг (regex + rapidfuzz)
# По умолчанию: true
AI_ENRICHMENT_ENABLED=true

# Выбор провайдера ИИ
# "antigravity" = Google Gemini через CLI `agy` (значение по умолчанию)
# "claude"      = Claude через Claude Agent SDK + локальный Claude Code CLI
AI_PROVIDER=antigravity

# Имя модели (используется обоими провайдерами)
# Для Antigravity: "gemini-3.5-flash" (по умолчанию), "gemini-2.0-flash-exp", и т.д.
# Для Claude:      "claude-sonnet-5" (рекомендуется), "claude-opus-4-8", и т.д.
AI_MODEL_NAME=gemini-3.5-flash

# ============================================================================
# 3A. ПРОВАЙДЕР: ANTIGRAVITY (Google Gemini через CLI)
# ============================================================================
# Используйте этот раздел, если AI_PROVIDER=antigravity
#
# Требования: установлен CLI `agy` (https://github.com/Vorkshim/antigravity)
# Авторизация: `agy --auth-code` (один раз на машине)

# Путь к исполняемому файлу `agy` (опционально)
# Если оставить пустым, будет использован `agy` из PATH
# ANTIGRAVITY_CLI_PATH=/path/to/agy

# ============================================================================
# 3B. ПРОВАЙДЕР: CLAUDE (Claude Agent SDK + локальный Claude Code CLI)
# ============================================================================
# Используйте этот раздел, если AI_PROVIDER=claude
#
# Транспорт: пакет claude-agent-sdk сам запускает установленный CLI `claude`
# и берёт авторизацию из логина Claude Code — без ручного OAuth-заголовка.
# Структурный ответ модели приходит нативно (output_format json-schema).
# Требование: установлен Claude Code CLI и выполнен вход (`claude` → /login).
#
# Выбор одного из способов аутентификации (порядок приоритета):
# - Способ 1: API-ключ (ANTHROPIC_API_KEY) — своя квота, устраняет 429 под нагрузкой
# - Способ 2: токен `claude setup-token` (CLAUDE_OAUTH_TOKEN) — прокидывается в CLI
#   как CLAUDE_CODE_OAUTH_TOKEN; это НЕ живой токен сессии → меньше конкуренции за квоту
# - Способ 3 (ничего не задавать): на macOS SDK/CLI берёт логин из keychain сам

# Путь к бинарю `claude` (опционально; пусто = авто-дискавери SDK)
# CLAUDE_CLI_PATH=/opt/homebrew/bin/claude
# Потолок ходов одного вызова (cost-guard; для одношагового ответа хватает малого)
# CLAUDE_MAX_TURNS=4

# Способ 1: API-ключ Anthropic (для prod, CI, Docker; единственный гарантированно без 429)
# Получить ключ: https://console.anthropic.com/account/keys
# Раскомментируйте и задайте свой ключ:
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Способ 2: токен сессии Claude Code (`claude setup-token`)
# Нужен там, где нет keychain (Linux, CI, docker); на macOS можно опустить (способ 3).
# CLAUDE_OAUTH_TOKEN=sk-ant-oat01-...
#
# ⚠️  ВАЖНО: любой OAuth-токен (и keychain-логин, и setup-token) привязан к той же
# подписке, что и Claude Code. Если в терминале активно работает Claude Code, сервис
# может получать 429 (rate_limit). setup-token конкурирует меньше живого логина сессии,
# но полностью отдельную квоту даёт только ANTHROPIC_API_KEY (способ 1).

# ============================================================================
# 4. БАЗА ДАННЫХ POSTGRESQL + PGVECTOR (для ИИ-памяти и семантического кэша)
# ============================================================================
# Строка подключения к PostgreSQL 15+ с расширением pgvector
# Используется для хранения:
# - Семантического кэша вызовов LLM (ускорение)
# - Структурированных фактов ИИ (промоушен в справочники)
# - Логов вызовов ИИ (наблюдаемость)
#
# DSN-формат: postgresql://user:password@host:port/database
# Дефолт (docker compose): postgresql://postgres:password@localhost:5432/picurl_ai
DATABASE_URL=postgresql://postgres:password@localhost:5432/picurl_ai

# ============================================================================
# 5. ПОРОГИ ПРОМОУШЕНА ИИ-ФАКТОВ В ДЕТЕРМИНИРОВАННЫЕ СПРАВОЧНИКИ
# ============================================================================
# После накопления знаний в БД ИИ некоторые факты можно «поднять» в локальные
# JSON-справочники (app/reference/*.json), чтобы обслуживать их детерминированно
# без обращения к LLM. Команда: uv run python -m app.ai.promotion

# Минимальное число независимых наблюдений, при котором факт готов к промоушену
# Дефолт: 5 (защита от единичной галлюцинации модели с высокой уверенностью)
AI_PROMOTION_MIN_OBSERVATIONS=5

# Минимальная уверенность модели в факте (0.0–1.0)
# Дефолт: 0.8 (80% уверенности)
AI_PROMOTION_MIN_CONFIDENCE=0.8

# Доля наблюдений фразы-алиаса, которая должна указывать на один и тот же фильтр,
# чтобы алиас можно было безопасно промоутить.
# 1.0 = требуется единогласие (любое расхождение → не промоутится)
# Дефолт: 1.0 (консервативный подход, защита от конфликтов)
AI_ALIAS_PROMOTION_MIN_CONSISTENCY=1.0
